# ──────────────────────────────────────────────
# FlowBoard Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values

# App
APP_SECRET=change_me_in_production

# AI Service (at least one required for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# JWT (auto-generated on first build)
JWT_PASSPHRASE=flowboard
