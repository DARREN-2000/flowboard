# ──────────────────────────────────────────────
# FlowBoard Backend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values

APP_ENV=dev
APP_SECRET=change_me_in_production

# Database
DATABASE_URL="postgresql://flowboard:flowboard_secret@postgres:5432/flowboard?serverVersion=16&charset=utf8"

# Redis
REDIS_URL="redis://redis:6379"

# Mercure (Real-time)
MERCURE_URL="http://mercure/.well-known/mercure"
MERCURE_PUBLIC_URL="http://localhost:9090/.well-known/mercure"
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"

# Messenger (Async Jobs)
MESSENGER_TRANSPORT_DSN="redis://redis:6379/messages"

# AI Service
AI_SERVICE_URL="http://ai-service:8000"

# JWT Authentication
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=flowboard

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
