# ──────────────────────────────────────────────
# FlowBoard Frontend Environment Variables
# ──────────────────────────────────────────────
# For local development:
VITE_API_URL=http://localhost:8080
VITE_MERCURE_URL=http://localhost:9090/.well-known/mercure

# For Render deployment (set via render.yaml):
# VITE_API_URL=https://flowboard-backend.onrender.com
# VITE_MERCURE_URL=  (empty — uses polling fallback on Render)
